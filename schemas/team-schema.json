        "id": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "nameFull": {
            "type": "string"
        },
        "nameMini": {
            "type": "string"
        },
        "sport": {
            "type": "string"
        },
        "city": {
            "type": "string"
        },
        "athleteIds": {
            "type": "array",
